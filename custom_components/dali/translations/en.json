    "issues": {
        "address_collision": {
            "fix_flow": {
                "abort": {
                    "cannot_connect": "Failed to connect",
                    "collision_remaining": "Some control gear still shares a short address. Check the DALI bus wiring and power, then try again.",
                    "not_loaded": "The DALI interface {title} is not loaded. Enable or reload the integration entry, then try again.",
                    "program_failed": "A device did not accept its new short address. Check the DALI bus wiring and power, then try again."
                },
                "progress": {
                    "resolve": "Clearing the shared short address and re-addressing the affected control gear. This can take a few minutes, depending on how many devices are connected."
                },
                "step": {
                    "confirm": {
                        "description": "Two or more pieces of DALI control gear on {title} share short addresses {addresses}. Home Assistant cannot control them individually, and commands meant for one reach all of them.\n\nSelect **Re-address gear** to clear the shared address and assign free short addresses to the affected gear. The fixture Home Assistant already knew at each address keeps that address, so your automations keep working; the newly added, conflicting fixture gets a free address and appears as a new device.\n\nWhen Home Assistant never saw a single device at an address before the collision, it cannot tell which fixture should keep it, so the addresses are assigned arbitrarily and automations targeting that address may now control a different fixture.\n\nIf another DALI controller manages this bus, resolve the collision with that controller instead to avoid conflicts.",
                        "submit": "Re-address gear",
                        "title": "Resolve DALI short-address collision"
                    }
                }
            },
            "title": "DALI control gear sharing a short address on {title}"
        },
        "bus_overload": {
            "description": "The DALI bus on {title} dropped below the voltage needed to communicate, even though its power supply is switched on. The bus power supply is most likely overloaded or undersized for the connected control gear and sensors. A long or faulty bus cable can have the same effect.\n\nUse a DALI bus power supply with a higher current rating, reduce the number of devices on the bus, or check the bus wiring. Home Assistant keeps retrying and clears this issue once the bus is stable again.",
            "title": "DALI bus power supply overloaded on {title}"
        },
        "bus_voltage_error": {
            "fix_flow": {
                "step": {
                    "confirm": {
                        "description": "The DALI bus on {title} has no power, so Home Assistant cannot reach any devices. This interface has an integrated power supply that can power the bus.\n\nSelect **Switch on bus power**, but only when no separate DALI power supply is connected, otherwise leave it off to avoid two power supplies on the bus.",
                        "submit": "Switch on bus power",
                        "title": "Power the DALI bus"
                    }
                }
            },
            "title": "No power on the DALI bus on {title}"
        },
        "unaddressed_controldevice": {
            "fix_flow": {
                "abort": {
                    "cannot_connect": "Failed to connect",
                    "not_loaded": "The DALI interface {title} is not loaded. Enable or reload the integration entry, then try again.",
                    "program_failed": "A device did not accept its new short address. Check the DALI bus wiring and power, then try again.",
                    "unaddressed_remaining": "Some devices are still without a short address. All 64 short addresses on this DALI bus may be in use. Remove unused devices from the bus, then try again."
                },
                "progress": {
                    "assign": "Searching the DALI bus and assigning short addresses. This can take a few minutes, depending on how many devices are connected."
                },
                "step": {
                    "confirm": {
                        "description": "Home Assistant found a DALI control device (such as a sensor or push button) on {title} that has no short address. Without a short address, these devices are not enumerated and do not appear in Home Assistant.\n\nSelect **Assign addresses** to assign free short addresses to these devices. Devices that already have a short address keep it.\n\nIf another DALI controller manages this bus, assign addresses with that controller instead to avoid conflicts.\n\nAfter the addresses are assigned, the new devices appear in Home Assistant automatically.",
                        "submit": "Assign addresses",
                        "title": "Assign DALI short addresses"
                    }
                }
            },
            "title": "DALI control devices without a short address on {title}"
        },
        "unaddressed_gear": {
            "fix_flow": {
                "abort": {
                    "cannot_connect": "Failed to connect",
                    "not_loaded": "The DALI interface {title} is not loaded. Enable or reload the integration entry, then try again.",
                    "program_failed": "A device did not accept its new short address. Check the DALI bus wiring and power, then try again.",
                    "unaddressed_remaining": "Some devices are still without a short address. All 64 short addresses on this DALI bus may be in use. Remove unused devices from the bus, then try again."
                },
                "progress": {
                    "assign": "Searching the DALI bus and assigning short addresses. This can take a few minutes, depending on how many devices are connected."
                },
                "step": {
                    "confirm": {
                        "description": "Home Assistant found DALI control gear on {title} that has no short address. Without a short address, these lights cannot be controlled individually and do not appear in Home Assistant.\n\nSelect **Assign addresses** to assign free short addresses to these devices. Devices that already have a short address keep it.\n\nIf another DALI controller manages this bus, assign addresses with that controller instead to avoid conflicts.\n\nAfter the addresses are assigned, the new lights appear in Home Assistant automatically.",
                        "submit": "Assign addresses",
                        "title": "Assign DALI short addresses"
                    }
                }
            },
            "title": "DALI devices without a short address on {title}"
        }
    }
